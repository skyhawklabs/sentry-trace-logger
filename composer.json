{
  "name": "fidello/sentry-trace-logger",
  "description": "CakePHP 5 plugin that injects the active Sentry trace ID into every Monolog record for log/Sentry correlation.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "sentry/sentry": "^4.0",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Fidello\\SentryTraceLogger\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fidello\\SentryTraceLogger\\Test\\": "tests/"
    }
  }
}
